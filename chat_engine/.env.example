OPENAI_API_KEY=
FEEDBACK_DB_SERVER=host,port
FEEDBACK_DB_NAME=
FEEDBACK_DB_USER=
FEEDBACK_DB_PASSWORD=

# Required — signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional — server bind address (keep 127.0.0.1 behind a tunnel/reverse proxy)
HOST=127.0.0.1
PORT=8084

# Optional — Microsoft Teams bot + tab (see SETUP.md "Microsoft Teams").
# From the Entra app registration behind your Azure Bot resource.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
# Public HTTPS address Teams reaches this server on, e.g. https://wai-xyz.devtunnels.ms
PUBLIC_BASE_URL=
# Any new GUID — identifies the Teams app package
TEAMS_APP_ID=
# Must match "Application ID URI" under Expose an API in the app registration.
# If left blank, defaults to api://<PUBLIC_BASE_URL host>/botid-<MICROSOFT_APP_ID> —
# but Azure rejects that as an identifier URI unless the host is a verified domain
# of your tenant, so you'll usually need to set this explicitly, e.g.
# api://<MICROSOFT_APP_TENANT_ID>/botid-<MICROSOFT_APP_ID>
TEAMS_SSO_RESOURCE=
# Bot is on when MICROSOFT_APP_ID is set; set false to turn it off
TEAMS_ENABLED=
# true to serve the Teams voice tab (needs HTTPS: switches cookies to SameSite=None)
TEAMS_TAB_ENABLED=false
# Set false only for testing when the Azure Bot's tenant doesn't match your real
# Teams tenant yet. Leave unset/true before real users go live.
TEAMS_ENFORCE_TENANT=

# Optional — speech (uses OPENAI_API_KEY)
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Optional — only needed for the scheduler/executor cron jobs (they no-op
# gracefully if unset)
SCHEDULER_DB_SERVER=
SCHEDULER_DB_PORT=
SCHEDULER_DB_NAME=
SCHEDULER_DB_USER=
SCHEDULER_DB_PASSWORD=
EXECUTOR_DB_SERVER=
EXECUTOR_DB_PORT=
EXECUTOR_DB_NAME=
EXECUTOR_DB_USER=
EXECUTOR_SCHEDULERDB_PASSWORD=
