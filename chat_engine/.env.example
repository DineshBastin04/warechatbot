OPENAI_API_KEY=
FEEDBACK_DB_SERVER=host,port
FEEDBACK_DB_NAME=
FEEDBACK_DB_USER=
FEEDBACK_DB_PASSWORD=

# Optional — only needed if the Microsoft Bot Framework / Teams channel adapter is used
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# Optional — only needed for the scheduler/executor cron jobs (they no-op
# gracefully if unset)
SCHEDULER_DB_SERVER=
SCHEDULER_DB_PORT=
SCHEDULER_DB_NAME=
SCHEDULER_DB_USER=
SCHEDULER_DB_PASSWORD=
EXECUTOR_DB_SERVER=
EXECUTOR_DB_PORT=
EXECUTOR_DB_NAME=
EXECUTOR_DB_USER=
EXECUTOR_SCHEDULERDB_PASSWORD=

# Optional — Warehouse Performance Intelligence Agent (automatic; see docs/warehouse_performance_agent.md).
# Nothing needs to be set: every workspace is analysed automatically. These only override deployment defaults.
# WPA_ENABLED=1
# WPA_INTERVAL_MINUTES=60
# WPA_TIMEZONE=            (defaults to SCHEDULE_DEFAULT_TIMEZONE)
# WPA_AUTO_EMAIL=1
# WPA_MAX_AUTO_EMAILS_PER_DAY=3
# WPA_RECIPIENT_LABELS=    (comma-separated saved Email Config labels; unset = all saved recipients)
# WPA_LOOKBACK_DAYS=35
# WPA_QUERY_TIMEOUT_SECONDS=30
# WPA_ROW_LIMIT=50000
# WPA_CATALOG_TTL_HOURS=24
# WPA_STORE_DIR=admin_store/warehouse_perf
# WPA_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# WPA_OLLAMA_HOST=http://localhost:11434
# WPA_LLM_TIMEOUT_SECONDS=60
